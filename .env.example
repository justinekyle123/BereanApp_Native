# Supabase configuration
# Copy this file to .env and fill in the values from your Supabase project.
# Find them at: Supabase Dashboard > Project Settings > API

# Your project's URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Your project's publishable (anon) key
# Note: new Supabase projects may label this "publishable key";
# in older projects it is called the "anon public" key. They are the same JWT.
EXPO_PUBLIC_SUPABASE_KEY=
